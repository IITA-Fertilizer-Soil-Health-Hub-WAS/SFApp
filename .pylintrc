[MAIN]
# Jupyter checkpoint copies are build artifacts, not source.
ignore-paths=^\.ipynb_checkpoints/.*$

[MESSAGE CONTROL]
# The lint job installs only pylint (not the app's dependencies), and this is a
# Streamlit / Earth Engine data app whose style intentionally differs from
# library code. Silence the resulting false positives and stylistic noise;
# genuine correctness checks (undefined-variable, function-redefined,
# used-before-assignment, syntax errors, ...) stay enabled.
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    invalid-name,
    broad-exception-caught,
    redefined-outer-name,
    redefined-builtin,
    unused-variable,
    unused-argument,
    unused-import,
    wildcard-import,
    unused-wildcard-import,
    import-error,
    no-name-in-module,
    no-member,
    duplicate-code,
    too-many-locals,
    too-many-arguments,
    too-many-positional-arguments,
    too-many-branches,
    too-many-statements,
    too-many-return-statements,
    too-many-lines,
    too-few-public-methods,
    line-too-long,
    trailing-whitespace,
    trailing-newlines,
    missing-final-newline,
    superfluous-parens,
    unnecessary-semicolon,
    wrong-import-order,
    wrong-import-position,
    import-outside-toplevel,
    unspecified-encoding,
    global-statement,
    global-variable-not-assigned,
    pointless-statement,
    expression-not-assigned,
    consider-using-f-string,
    consider-using-with,
    use-dict-literal,
    no-else-return,
    no-else-break,
    inconsistent-return-statements,
    unnecessary-pass,
    fixme

[TYPECHECK]
# Third-party packages that are not installed in the lint-only CI job.
ignored-modules=ee,geemap,geemap.foliumap,folium,streamlit,geopandas,shapely,
    shapely.geometry,plotly,plotly.graph_objects,plotly.subplots,google,
    google.cloud,dotenv,pandas,numpy,matplotlib,PIL,chardet,geojson

[FORMAT]
max-line-length=550

[REPORTS]
# Gate the build on a minimum quality score. Keeps the lint meaningful while
# allowing the app's current style; raise over time as the code is cleaned up.
fail-under=7.0
